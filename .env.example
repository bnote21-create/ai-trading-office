# กุญแจ Gemini API (หากต้องการให้ AI วิเคราะห์เชิงลึกด้วย LLM)
# สมัครฟรีได้ที่: https://aistudio.google.com/
GEMINI_API_KEY=

# สำหรับการแจ้งเตือนเข้า Telegram Bot (แนะนำ: เสถียรและฟรีตลอดชีพ)
# 1. ทักหา @BotFather บน Telegram เพื่อสร้างบอทแล้วรับ Token
# 2. ทักหา @userinfobot เพื่อดู Chat ID ของคุณ
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# สำหรับการแจ้งเตือนเข้า LINE (เลือกใช้อย่างใดอย่างหนึ่ง)
# แบบที่ 1: LINE Notify Token (ง่ายที่สุด)
LINE_NOTIFY_TOKEN=

# หรือ แบบที่ 2: LINE Messaging API
LINE_CHANNEL_ACCESS_TOKEN=
LINE_USER_ID=
